{
  "manifest_version": 3,
  "name": "Bet Bot — DK Sync",
  "version": "3.4",
  "description": "Syncs your DraftKings bets to Bet Bot in real time",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.draftkings.com/*",
    "https://*.up.railway.app/*",
    "https://*.livebetbot.com/*",
    "https://livebetbot.com/*",
    "http://localhost:3000/*",
    "https://*.paramountplus.com/*",
    "https://*.ufcfightpass.com/*",
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.draftkings.com/*"
      ],
      "js": [
        "intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.draftkings.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.livebetbot.com/*",
        "https://livebetbot.com/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bet Bot DK Sync",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_iframe_unblock",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}